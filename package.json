{
  "name": "orbital-books",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "start": "PORT=${PORT:-3000} HOST=${ORBITAL_HOST:-127.0.0.1} react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "test": "vitest run",
    "data:bookshop": "node tools/convert-bookshop.ts",
    "data:sample": "node tools/sample-data.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@react-router/node": "8.5.1",
    "@react-router/serve": "8.5.1",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@recast-navigation/core": "0.43.1",
    "@recast-navigation/generators": "0.43.1",
    "@tellim/analytics": "file:packages/analytics",
    "@tellim/kit": "file:packages/kit",
    "@tellim/music": "file:packages/music",
    "@tellim/platform": "file:packages/platform",
    "echarts": "6.1.0",
    "isbot": "5.1.36",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.5.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@react-router/dev": "8.5.1",
    "@types/node": "22.20.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/three": "0.186.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
